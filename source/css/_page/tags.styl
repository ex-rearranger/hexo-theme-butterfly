.tag-cloud
  &-list
    // animation: tagsFadeIn .6s cubic-bezier(.4, 0, .2, 1)

    // &:hover a:not(:hover)
    //   opacity: .7
    //   transform: scale(.98)

    a
      display: inline-flex
      margin: 0 4px 8px 4px
      // padding: 3px 12px
      line-height: 1
      transition: all .3s cubic-bezier(.4, 0, .2, 1)
      addBorderRadius(4)
      // overflow: hidden
      // color: white
      transform: translateY(-2px) scale(1.02)
      will-change: transform, color, box-shadow

      // additionals
      border: 1px solid
      vertical-align: middle
      background: var(--card-bg)
      box-shadow:
        0 2px 3px var(--card-hover-box-shadow),
        0 4px 8px var(--card-hover-box-shadow)

      &:hover
        color: var(--text-hover) !important

      &:active
        box-shadow: none
        transition: all .15s cubic-bezier(.4, 0, .2, 1)
        transform: translateY(0) scale(1)

      // +maxWidth768()
      //   zoom: .85

      //   &:hover
      //     transform: translateY(-1px) scale(1.01)

      //   &:active
      //     transform: translateY(0) scale(.99)

      //   &::before
      //     display: none

      span
        padding: 4px 8px 4px
      
      span:first-child
        border-right: 1px solid

  &-title
    font-size: 2.57em
    // animation: titleSlideIn .8s cubic-bezier(.4, 0, .2, 1)

    +maxWidth768()
      font-size: 2em

