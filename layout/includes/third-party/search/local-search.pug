#local-search
  .search-dialog
    nav.search-nav
      each langPrefix, lang in langPrefices
        span(lang-type='relative' language=lang).search-dialog-title= _p(langPrefix+'search.title')
      span#loading-status
      button.search-close-button
        i.fas.fa-times

    #loading-database.text-center
      i.fas.fa-spinner.fa-pulse
      each langPrefix, lang in langPrefices
        span(lang-type='relative' language=lang)= '  ' + _p(langPrefix+'search.load_data')

    .local-search-input
      input(placeholder=theme.search.placeholder || _p("search.input_placeholder") type="text")

    hr

    #local-search-results
    #local-search-pagination.ais-Pagination(style="display:none;")
      ul.ais-Pagination-list
    #local-search-stats

  #search-mask
  script(src=url_for(theme.asset.local_search))