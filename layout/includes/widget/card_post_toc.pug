- let tocNumber = typeof page.toc_number === 'boolean' ? page.toc_number : theme.toc.number
- let tocExpand = typeof page.toc_expand === 'boolean' ? page.toc_expand : theme.toc.expand
- let tocExpandClass = tocExpand ? 'is-expand' : ''

if (page.encrypt == true)
  #card-toc.card-widget(style="display:none")
    .item-headline
      i.fas.fa-stream
      each langPrefix, lang in langPrefices
        span(lang-type='relative' language=lang)= _p(langPrefix+'aside.card_toc')
      span.toc-percentage
    .toc-content(class=tocExpandClass)!=toc(page.origin, {list_number: tocNumber})
else
  #card-toc.card-widget
    .item-headline
      i.fas.fa-stream
      each langPrefix, lang in langPrefices
        span(lang-type='relative' language=lang)= _p(langPrefix+'aside.card_toc')
      span.toc-percentage
    .toc-content(class=tocExpandClass)!=toc(page.content, {list_number: tocNumber})
